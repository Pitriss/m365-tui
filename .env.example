# Copy to `.env` and fill in. The TUI reads this from the repo root; docker
# compose reads the same file for the webhook + tunnel.

# ── Required ────────────────────────────────────────────────────────────────
# Entra application (client) ID of your registered public client.
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Auth (optional) ─────────────────────────────────────────────────────────
# Tenant: your directory (GUID) or `organizations` (work/school) or `common`.
M365_TENANT_ID=organizations
# Space-separated scopes. Leave unset to use the sensible defaults in the code.
# M365_SCOPES=openid profile offline_access User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite Chat.ReadWrite ChannelMessage.Read.All ChannelMessage.Send Presence.Read.All People.Read

# Where the encrypted-at-0600 token cache lives (defaults to the OS config dir).
# M365_TOKEN_CACHE=/home/you/.config/m365-tui/token-cache.json

# Talk to something other than the real Graph. Only useful for testing against a
# mock; leave unset for normal use.
# M365_GRAPH_BASE=http://127.0.0.1:8765/v1.0

# Desktop notifications for direct messages and @mentions (on by default).
# Group chats stay silent unless you're mentioned. Set to 0 to disable.
# M365_NOTIFY=0

# Seconds an unread Outlook message must remain open before it is marked read.
# Default: 0 (mark read immediately after the message body is displayed).
# M365_READ_MSG_TIMEOUT=0

# Opt in to Teams *channels* (adds the Team.ReadBasic.All scope, needed to list
# the teams you belong to). Chats work without it. Same consent caveat as below.
# M365_TEAMS_CHANNELS=1

# Show regular Teams image file attachments (PNG/JPEG/GIF) through Kitty.
# Adds the delegated Files.Read.All scope when default scopes are used.
# If M365_SCOPES is set explicitly, include Files.Read.All there yourself.
# M365_TEAMS_FILE_IMAGES=1

# Optional persistent Teams cache root.
# The historical variable name is kept for backward compatibility.
# If unset, Teams image caching stays RAM-only and persistent UI state / cached
# chat conversations are disabled. The root is private on Unix; image thumbnails
# and conversation JSON are stored below it. Conversation data is plaintext and
# is not encrypted.
# M365_TEAMS_IMAGE_CACHE_DIR=/home/user/.cache/m365-tui/teams-images
# M365_TEAMS_IMAGE_CACHE_MAX_MB=256

# Teams system-event visibility.
# useful = useful + unknown events, known low-value noise hidden (default)
# all    = all known and unknown system events
# none   = hide all system events
# M365_TEAMS_SYSTEM_EVENTS=useful

# Automatically prefill persistent Teams chat caches in the background.
# Enabled by default when M365_TEAMS_IMAGE_CACHE_DIR is configured.
# Large tenants can disable this Graph warm-up while keeping cache-on-open and
# local cached previews for chats that were already cached.
# M365_TEAMS_CACHE_WARMUP=0

# Optional executable for Calendar online-meeting links.
# Leave unset to use the system handler (xdg-open on Linux, open on macOS).
# The meeting URL is passed directly as one argument; no shell is involved.
# M365_MEETING_OPENER=/usr/bin/firefox

# Opt in to *setting* your own presence (adds the Presence.ReadWrite scope).
# Off by default: adding a scope invalidates existing consent, so in tenants that
# require admin approval every sign-in would need re-approval. Enable only after
# Presence.ReadWrite is added to the app registration and consented.
# M365_PRESENCE_WRITE=1

# Keep an application presence session active while m365-tui is running.
# This makes m365-tui behave as an active Teams presence client without
# setting a sticky user-preferred status. Implies Presence.ReadWrite when
# M365_SCOPES is not explicitly overridden.
# M365_PRESENCE_PRIMARY=1

# Minutes of m365-tui inactivity before the primary presence session changes
# from Available to Away. Any keypress or bracketed paste changes it back to
# Available. Default: 5 minutes. Set to 0 to keep Available indefinitely.
# M365_PRESENCE_AVAILABLE_TIMEOUT_MIN=5

# Show presence/status for contacts in one-to-one Teams chats. Presence.Read.All
# is already part of the default scopes; this flag only enables the UI feature.
# M365_PRESENCE_READ=1

# ── Real-time (optional; leave M365_TUNNEL_BASE_URL empty for poll-only) ──────
# Public HTTPS base that Cloudflare routes to the webhook, e.g.
# https://m365.example.com  (NO trailing slash, NO path).
M365_TUNNEL_BASE_URL=

# Shared secret echoed in subscription clientState and verified by the webhook.
# Generate one: `uuidgen` or `openssl rand -hex 16`. MUST match on both sides.
M365_CLIENT_STATE=

# Redis URL the TUI connects to (the webhook uses redis://redis:6379 internally).
M365_REDIS_URL=redis://127.0.0.1:6379

# Cloudflare named-tunnel token (from the Zero Trust dashboard). Used by the
# cloudflared container only.
CLOUDFLARE_TUNNEL_TOKEN=
