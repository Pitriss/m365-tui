# Configuration for the real-time stack only (webhook + Redis + tunnel).
# `./up.sh` copies this to `.env` and fills in M365_CLIENT_STATE for you.
#
# This is NOT the TUI's .env — the TUI has its own, and needs the two values
# printed at the end of ./up.sh.

# ── Named tunnel (recommended) ──────────────────────────────────────────────
# Token from the Cloudflare Zero Trust dashboard (Networks → Tunnels → your
# tunnel → Install and run a connector). Route a hostname on your domain to
# http://webhook:8080.
#
# Leave this empty to use a throwaway trycloudflare.com tunnel instead
# (./up.sh --quick), which needs no account and no domain.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Shared secret ───────────────────────────────────────────────────────────
# Echoed by Graph in every notification's clientState and verified here, so
# nobody who guesses your tunnel URL can inject fake events.
#
# MUST be identical to M365_CLIENT_STATE in the TUI's .env. ./up.sh generates one
# if you leave it blank, and prints it for you to copy across.
M365_CLIENT_STATE=

# ── Ports (optional) ────────────────────────────────────────────────────────
# Both are published on 127.0.0.1 only. Change them if something already has the
# port; if you change REDIS_PORT, set a matching M365_REDIS_URL in the TUI's .env.
# REDIS_PORT=6379
# WEBHOOK_PORT=8080

# Log verbosity of the webhook container (`docker compose logs webhook`).
# RUST_LOG=debug
